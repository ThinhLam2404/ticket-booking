generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AdminPermission {
  MANAGE_MOVIES
  MANAGE_CINEMAS
  MANAGE_SHOWTIMES
  VIEW_BOOKINGS
  MANAGE_PAYMENTS
  VIEW_SYSTEM
  MANAGE_USERS
  VIEW_AUDIT_LOGS
}

enum MovieStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SeatType {
  STANDARD
  VIP
  COUPLE
}

enum RoomFormat {
  STANDARD
  IMAX
  FOUR_DX
  SCREEN_X
}

enum ShowtimeFormat {
  TWO_D_SUBTITLED
  TWO_D_DUBBED
  THREE_D_SUBTITLED
  THREE_D_DUBBED
}

enum ShowtimeSeatStatus {
  AVAILABLE
  HELD
  SOLD
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SepayIntentStatus {
  PENDING
  SUCCEEDED
  EXPIRED
  CANCELLED
}

enum SepayTransactionStatus {
  MATCHED
  CONFIRMED
  REVIEW_REQUIRED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum MailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum MailOutboxType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TICKETS_ISSUED
  REFUND_NOTIFICATION
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  fullName                String
  role                    UserRole                 @default(CUSTOMER)
  emailVerifiedAt         DateTime?
  disabledAt              DateTime?
  authSessions            AuthSession[]
  adminPermissions        UserAdminPermission[]
  passwordResetTokens     PasswordResetToken[]
  bookings                Booking[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  refunds                 Refund[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model UserAdminPermission {
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission AdminPermission
  createdAt  DateTime      @default(now())

  @@id([userId, permission])
  @@index([permission])
}

model AuditLog {
  id           String   @id @default(cuid())
  requestId    String?
  actorUserId  String?
  actorEmail   String?
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

model Movie {
  id          String      @id @default(cuid())
  tmdbId      Int?        @unique
  title       String
  description String?
  posterUrl   String?
  backdropUrl String?
  trailerKey  String?
  releaseDate DateTime?
  rating      Decimal?    @db.Decimal(3, 1)
  genres      String[]    @default([])
  ageRating   String?
  duration    Int
  status      MovieStatus @default(DRAFT)
  showtimes   Showtime[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Cinema {
  id           String   @id @default(cuid())
  name         String
  address      String
  provinceCode Int      @default(79)
  rooms        Room[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([provinceCode])
}

model Room {
  id        String     @id @default(cuid())
  name      String
  format    RoomFormat @default(STANDARD)
  cinemaId  String
  cinema    Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seats     Seat[]
  showtimes Showtime[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([cinemaId, name])
  @@index([format])
}

model Seat {
  id            String         @id @default(cuid())
  row           String
  number        Int
  type          SeatType       @default(STANDARD)
  roomId        String
  room          Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  showtimeSeats ShowtimeSeat[]

  @@unique([roomId, row, number])
}

model Showtime {
  id               String         @id @default(cuid())
  startsAt         DateTime
  endsAt           DateTime
  movieId          String
  movie            Movie          @relation(fields: [movieId], references: [id], onDelete: Restrict)
  roomId           String
  room             Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  format           ShowtimeFormat @default(TWO_D_SUBTITLED)
  basePrice        Decimal        @db.Decimal(10, 2)
  vipMultiplier    Decimal        @db.Decimal(5, 2)
  coupleMultiplier Decimal        @db.Decimal(5, 2)
  showtimeSeats    ShowtimeSeat[]
  bookings         Booking[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([movieId, startsAt])
  @@index([roomId, startsAt, endsAt])
  @@index([format, startsAt])
}

model ShowtimeSeat {
  id              String             @id @default(cuid())
  price           Decimal            @db.Decimal(10, 2)
  status          ShowtimeSeatStatus @default(AVAILABLE)
  heldUntil       DateTime?
  showtimeId      String
  showtime        Showtime           @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatId          String
  seat            Seat               @relation(fields: [seatId], references: [id], onDelete: Restrict)
  bookingItems    BookingItem[]
  heldByBookingId String?
  heldByBooking   Booking?           @relation("BookingSeatHolds", fields: [heldByBookingId], references: [id], onDelete: SetNull)

  @@unique([showtimeId, seatId])
  @@index([showtimeId, status])
  @@index([heldByBookingId])
}

model AuthSession {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id              String    @id @default(cuid())
  jti             String    @unique
  tokenHash       String
  familyId        String
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByJti   String?
  reuseDetectedAt DateTime?
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model MailOutbox {
  id            String           @id @default(cuid())
  type          MailOutboxType
  status        MailOutboxStatus @default(PENDING)
  recipient     String
  dedupeKey     String           @unique
  payload       Json
  attemptCount  Int              @default(0)
  nextAttemptAt DateTime         @default(now())
  sentAt        DateTime?
  lastError     String?
  lockedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, nextAttemptAt])
}

model Booking {
  id             String              @id @default(cuid())
  status         BookingStatus       @default(PENDING)
  totalAmount    Decimal             @db.Decimal(10, 2)
  expiresAt      DateTime
  holdToken      String
  idempotencyKey String?
  requestHash    String?
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  showtimeId     String
  showtime       Showtime            @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  items          BookingItem[]
  heldSeats      ShowtimeSeat[]      @relation("BookingSeatHolds")
  payment        Payment?
  sepayIntent    SepayPaymentIntent?
  tickets        Ticket[]
  refunds        Refund[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([holdToken])
  @@index([userId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([status, expiresAt])
}

model BookingItem {
  id             String       @id @default(cuid())
  price          Decimal      @db.Decimal(10, 2)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showtimeSeatId String
  showtimeSeat   ShowtimeSeat @relation(fields: [showtimeSeatId], references: [id], onDelete: Restrict)
  ticket         Ticket?

  @@unique([bookingId, showtimeSeatId])
}

model Payment {
  id        String        @id @default(cuid())
  provider  String
  reference String?       @unique
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(10, 2)
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds   Refund[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Ticket {
  id            String       @id @default(cuid())
  code          String       @unique
  status        TicketStatus @default(ACTIVE)
  bookingId     String
  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bookingItemId String       @unique
  bookingItem   BookingItem  @relation(fields: [bookingItemId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())
  usedAt        DateTime?

  @@index([bookingId, createdAt, id])
}

model SepayPaymentIntent {
  id             String             @id @default(cuid())
  paymentCode    String             @unique
  status         SepayIntentStatus  @default(PENDING)
  expectedAmount Decimal            @db.Decimal(10, 2)
  expiresAt      DateTime
  bookingId      String             @unique
  booking        Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  userId         String
  transactions   SepayTransaction[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, expiresAt])
  @@index([paymentCode])
}

model SepayTransaction {
  id              String                 @id @default(cuid())
  sepayId         Int                    @unique
  gateway         String
  accountNumber   String
  transferAmount  Decimal                @db.Decimal(10, 2)
  content         String
  referenceCode   String?
  transferType    String
  transactionDate DateTime
  status          SepayTransactionStatus @default(MATCHED)
  adminNote       String?
  paymentIntentId String?
  paymentIntent   SepayPaymentIntent?    @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  refunds         Refund[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([paymentIntentId])
  @@index([status, transactionDate, id])
}

model Refund {
  id             String            @id @default(cuid())
  bookingId      String
  booking        Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentId      String
  payment        Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  transactionId  String?
  transaction    SepayTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  amount         Decimal           @db.Decimal(10, 2)
  reason         String
  adminNote      String?
  adminId        String
  admin          User              @relation(fields: [adminId], references: [id], onDelete: Restrict)
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())

  @@index([bookingId])
  @@index([paymentId])
  @@index([adminId])
  @@unique([bookingId])
}
