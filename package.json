{
  "name": "ticket-booking",
  "version": "0.0.1",
  "description": "Movie ticket booking system with NestJS backend and React frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "install:all": "npm install --prefix be && npm install --prefix fe",
    "dev": "concurrently --kill-others-on-fail --names be,fe --prefix-colors blue,green \"npm run dev:be\" \"npm run dev:fe\"",
    "dev:all": "npm run infra:up && npm run dev",
    "dev:be": "npm --prefix be run start:dev",
    "dev:fe": "npm --prefix fe run dev",
    "build": "npm run prisma:generate && npm run build:be && npm run build:fe",
    "build:be": "npm --prefix be run build",
    "start:heroku": "npm run prisma:deploy && npm --prefix be run start:prod",
    "heroku-postbuild": "npm install --prefix be --include=dev && npm --prefix be run prisma:generate && npm --prefix be run build",
    "build:fe": "npm --prefix fe run build",
    "lint": "npm run lint:be && npm run lint:fe",
    "lint:be": "npm --prefix be run lint",
    "lint:fe": "npm --prefix fe run lint",
    "typecheck": "npm run typecheck:be && npm run typecheck:fe",
    "typecheck:be": "npm --prefix be run typecheck",
    "typecheck:fe": "npm --prefix fe run typecheck",
    "format": "npm --prefix be run format",
    "test": "npm --prefix be run test",
    "test:fe": "npm --prefix fe run test",
    "test:e2e": "npm --prefix be run test:e2e",
    "test:cov": "npm --prefix be run test:cov",
    "test:all": "npm run test && npm run test:fe && npm run test:e2e",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test tests/browser/app-smoke.spec.ts --project=chromium-desktop",
    "test:browser:ui": "playwright test --ui",
    "test:browser:full": "node scripts/run-browser-tests.mjs",
    "test:integration": "npm --prefix be run test:integration",
    "benchmark:ticket-booking": "node scripts/benchmark-ticket-booking.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:all",
    "check:ci": "npm run api:check && npm run check && npm run test:integration",
    "infra:up": "docker compose -f be/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f be/docker-compose.yml down",
    "infra:ps": "docker compose -f be/docker-compose.yml ps",
    "prisma:generate": "npm --prefix be run prisma:generate",
    "prisma:migrate": "npm --prefix be run prisma:migrate --",
    "prisma:deploy": "npm --prefix be run prisma:deploy",
    "prisma:seed": "npm --prefix be run prisma:seed",
    "prisma:studio": "npm --prefix be run prisma:studio",
    "api:spec": "npm --prefix be run openapi:export -- ../openapi/ticket-booking.openapi.json",
    "api:types": "openapi-typescript openapi/ticket-booking.openapi.json --output fe/src/generated/openapi.d.ts",
    "api:generate": "npm run api:spec && npm run api:types",
    "api:check": "node scripts/check-api-artifacts.mjs",
    "test:api:contract": "node scripts/check-api-contract.mjs",
    "docker:up": "docker compose --env-file be/.env -f docker-compose.app.yml up --build -d --wait",
    "docker:down": "docker compose --env-file be/.env -f docker-compose.app.yml down",
    "docker:logs": "docker compose --env-file be/.env -f docker-compose.app.yml logs -f --tail=100",
    "ops:backup-restore-drill": "node scripts/ops/run-backup-restore-drill.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.52.0",
    "concurrently": "^10.0.5",
    "openapi-typescript": "7.13.0"
  }
}
